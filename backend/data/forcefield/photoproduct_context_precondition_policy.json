{
  "schema": "nadoc.photoproduct-context-precondition-policy.v1",
  "version": "1.0.0",
  "status": "preregistered_candidate_validation_policy",
  "gate_effect": "none",
  "placement_seed": {
    "method": "proper-rotation four-anchor QM base placement",
    "reflection_allowed": false,
    "moved_atoms": "selected base heavy atoms only",
    "maximum_anchor_rmsd_angstrom": 4.0,
    "maximum_glycosidic_error_angstrom": 1.5,
    "maximum_base_displacement_angstrom": 10.0,
    "minimum_nonbonded_vdw_ratio": 0.3,
    "role": "catastrophic seed screen only; none of these relaxed limits is a final geometry acceptance criterion"
  },
  "local_minimization": {
    "engine": "NAMD",
    "ordinary_mass": true,
    "timestep_fs": 1.0,
    "steps": 10000,
    "mobile_residue_radius": 2,
    "nonlocal_harmonic_k_kcal_mol_angstrom2": 10.0,
    "rigid_bonds": "none"
  },
  "final_acceptance": {
    "chirality_retention_fraction": 1.0,
    "product_ring_bond_range_angstrom": [1.25, 1.85],
    "glycosidic_bond_range_angstrom": [1.25, 1.75],
    "selected_to_flank_bond_range_angstrom": [1.3, 1.9],
    "minimum_nonbonded_covalent_radius_ratio": 0.7,
    "maximum_nonlocal_displacement_angstrom": 0.75,
    "maximum_nonlocal_rmsd_angstrom": 0.25,
    "finite_energy_records_required": true,
    "unclassified_engine_warnings_allowed": false
  },
  "authorization": "A pass creates a candidate coordinate seed for explicit-solvent testing only. It cannot pass a production registry gate, prove ensemble stability, or replace matched reactant/product validation."
}
