    },
    {
      "stage": "P3_nonbonded_validation",
      "finish_when": "Every leave-one-orientation-out fold passes existing water energy/distance limits and a new fourth orientation also passes frozen parameters.",
      "reassess": "Only then fit/validate Drude-consistent LJ and bonded terms."
    },
    {
      "stage": "P4_engine_context",
      "finish_when": "A full Drude d(TpT) PSF, SWM4-NDP solution smoke at <=1 fs, and both duplex contexts pass topology, chirality, finite-energy, and reproducibility audits.",
      "reassess": "Only this stage may request a simulation-ready release review."
    }
  ],
  "decision": "Keep the additive integration-only candidate and all production registry entries blocked. Continue with a fully consistent Drude response campaign rather than further atom-centered or fixed-site tuning."
