  "priority_order": [
    {
      "rank": 1,
      "isomer": "tt-cpd-cis-anti-i",
      "action": "Repair/requalify the corrected core and DNA model first; earlier anti fitting/MD cannot be adopted as corrected identity evidence.",
      "reason": "514 intended pair-frame samples across 37 ordered TT pairs (34 crossover-pair groups) in two pilot designs. Dominates intended-weld opportunities under all 27 windows."
    },
    {
      "rank": 2,
      "isomer": "tt-cpd-cis-syn-ii",
      "action": "Audit reuse of the existing endpoint-exchanged capped core, then build and check its own ordered DNA boundary/template.",
      "reason": "262 samples across 20 TT pairs, in every temporal quarter and every window. Covers intended welds plus competing interstrand and nonadjacent products. Existing capped-core equivalence offers a possible cost saving, not automatic full-DNA parameter transfer."
    },
    {
      "rank": 3,
      "isomer": "tt-cpd-trans-syn-ii",
      "action": "Prioritize as the next trans candidate; inspect existing trajectory windows/site placement before a full refinement campaign.",
      "reason": "17 intended samples across 8 TT pairs (7 crossover-pair groups), spanning all four temporal quarters. Stronger intended-weld signal than cis-syn-II at the primary window, but disappears at the strict distance cutoff. Archived capped QM minimum exists."
    },
    {
      "rank": 4,
      "isomer": "tt-cpd-cis-anti-ii",
      "action": "Confirm the competing interstrand hotspot with more existing frames/lineages before expensive refinement.",
      "reason": "36 samples; 34 belong to one native/native interstrand pair, all signal in the latter half. Only one primary intended-weld sample. Corrected identity has no transferred minimum."
    },
    {
      "rank": 5,
      "isomer": "tt-cpd-trans-syn-i",
      "action": "Keep as a lower-priority competitor; defer dedicated refinement unless broader screening strengthens the signal.",
      "reason": "14 samples across 3 TT pairs; 13 are adjacent intrastrand competitors and one is intended. Archived capped QM minimum exists."
    },
    {
      "rank": 6,
      "isomer": "tt-cpd-trans-anti-i",
      "action": "Defer full refinement; retain in screening.",
      "reason": "Three isolated competing samples at three pairs; no intended-weld samples in any tested window."
    },
    {
      "rank": 7,
      "isomer": "tt-cpd-trans-anti-ii",
      "action": "Defer full refinement; retain in screening.",
      "reason": "No primary samples; at most four all-pair samples and no intended-weld samples in the permissive sensitivity grid. Zero does not establish impossibility."
    }
  ],
