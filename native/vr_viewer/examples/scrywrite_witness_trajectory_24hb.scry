SCRYWRITE_WITNESS 1
# Run with playback-md publishing the real 24hb_1xT trajectory snapshot. The
# companion viewer metrics must show coordinate_update records throughout each
# hold, zero sequence gaps, and update total_ms below the 11.11 ms HMD budget.
head 0 1.60 0 1 0 0 0
pose right 0.28 1.72 -0.60 1 0 0 0
pose left -0.24 1.28 -0.24 1 0 0 0
step 120
button right menu down
step 2
button right menu up
step 45
# Keep the spawned sidebar fixed; center its full frame in the actor camera.
head 0 1.50 0.08 1 0 0 0
step 2
# Select the current Visualization sidebar tab.
aim_menu left right_visualization_[tab:visualization]
step 20
button left trigger down
step 2
button left trigger up
step 30
expect menu sidebars
expect representation ballstick
expect layout valid
expect display submitted
expect tracking tracked
expect overlay visible
expect framing valid
snapshot trajectory_ballstick_start

# Open playback through the current left Simulations sidebar. Stable control IDs
# keep aiming valid while frame counters and the Play/Pause label change.
# Spawn both sidebars from the same head pose, and aim from in front of them.
head 0 1.60 0 1 0 0 0
pose right 0.28 1.28 -0.24 1 0 0 0
button left menu down
step 2
button left menu up
step 20
head 0 1.50 0.08 1 0 0 0
step 2
aim_menu right tab:dynamics
step 20
button right trigger down
step 2
button right trigger up
step 20
aim_menu right sim:trajectory
step 20
button right trigger down
step 2
button right trigger up
step 20
expect menu sidebars
expect layout valid
aim_menu right trajectory:play
step 12
button right trigger down
step 2
button right trigger up
aim_menu right trajectory:seek
step 12
button right trigger down
step 2
button right trigger up
aim_menu right trajectory:back
step 12
button right trigger down
step 2
button right trigger up
step 20
expect menu sidebars
button left menu down
step 2
button left menu up

# Close the opaque tablet for each hold so captures are the unobstructed HMD-eye
# molecular view, then reopen it only to request the next representation.
button right menu down
step 2
button right menu up
# Side-on actor eye: the origami's long axis is native +Z/-Z, so looking from +X
# exposes the full bundle length instead of validating only its end-on cross-section.
head 0.75 0 -1.30 0.7071068 0 0.7071068 0
step 30
expect menu closed
snapshot trajectory_ballstick_unobstructed

# Hold for two seconds of real headset frames while trajectory updates arrive.
step 180
expect representation ballstick
expect display submitted
expect tracking tracked
snapshot trajectory_ballstick_end

head 0 1.60 0 1 0 0 0
button right menu down
step 2
button right menu up
head 0.75 0 -1.30 0.7071068 0 0.7071068 0
step 30
expect menu sidebars
aim_menu left right_stick_[menu-view-atomistic-stick]
step 20
expect hover right_stick_[menu-view-atomistic-stick]
button left trigger down
step 2
button left trigger up
step 45
expect representation stick
expect display submitted
expect tracking tracked
snapshot trajectory_stick_start
button right menu down
step 2
button right menu up
step 30
expect menu closed
snapshot trajectory_stick_unobstructed
step 180
expect representation stick
expect display submitted
expect tracking tracked
snapshot trajectory_stick_end

head 0 1.60 0 1 0 0 0
button right menu down
step 2
button right menu up
head 0.75 0 -1.30 0.7071068 0 0.7071068 0
step 30
expect menu sidebars
aim_menu left right_full_[menu-view-detail-full]
step 20
expect hover right_full_[menu-view-detail-full]
button left trigger down
step 2
button left trigger up
step 45
expect representation full
expect display submitted
expect tracking tracked
snapshot trajectory_full_start
button right menu down
step 2
button right menu up
step 30
expect menu closed
snapshot trajectory_full_unobstructed
step 180
expect representation full
expect display submitted
expect tracking tracked
snapshot trajectory_full_end

# Finish by crossing the coarse/atomistic boundary during active playback.
head 0 1.60 0 1 0 0 0
button right menu down
step 2
button right menu up
head 0.75 0 -1.30 0.7071068 0 0.7071068 0
step 30
expect menu sidebars
aim_menu left right_ball_&_stick_[menu-view-atomistic-ballstick]
step 20
expect hover right_ball_&_stick_[menu-view-atomistic-ballstick]
button left trigger down
step 2
button left trigger up
step 45
expect representation ballstick
expect display submitted
expect tracking tracked
snapshot trajectory_ballstick_return
button right menu down
step 2
button right menu up
step 30
expect menu closed
snapshot trajectory_ballstick_return_unobstructed
