SCRYWRITE_WITNESS 1
# Deterministic actor pose: open the right sidebar and capture the same
# actor-eye framebuffer displayed on the in-world witness monitor.
head 0 1.60 0 1 0 0 0
pose right 0.28 1.72 -0.60 1 0 0 0
pose left -0.24 1.28 -0.24 1 0 0 0
step 90
button right menu down
step 2
button right menu up
step 30
# Keep the spawned sidebar fixed; center its full frame in the actor camera.
head 0 1.50 0.08 1 0 0 0
step 2
expect menu sidebars
expect layout valid
expect display submitted
expect tracking tracked
expect overlay visible
expect framing valid
snapshot sidebar_open

aim_menu left right_tools_[tab:tools]
step 30
expect hover right_tools_[tab:tools]
snapshot sidebar_tools_hover
button left trigger down
step 2
button left trigger up
step 30
expect menu sidebars
expect layout valid
snapshot tools_open

aim_menu left right_move_rotate_[tool-move]
step 30
expect hover right_move_rotate_[tool-move]
snapshot tools_move_rotate_hover
button left trigger down
step 2
button left trigger up
step 60
expect tool move_rotate
expect status select_target
expect menu sidebars
expect layout valid
snapshot move_rotate_select_target
