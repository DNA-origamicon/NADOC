SCRYWRITE_WITNESS 1
# Full semantic replay for the atomistic representations exposed by the native
# Visualization sidebar. Run with the real 24hb scene and latest-frame visualization.
head 0 1.60 0 1 0 0 0
pose right 0.28 1.72 -0.60 1 0 0 0
pose left -0.24 1.28 -0.24 1 0 0 0
step 120
button right menu down
step 2
button right menu up
step 45
# Keep the spawned sidebar fixed; center its full frame in the actor camera.
head 0 1.50 0.08 1 0 0 0
step 2
# Select the current Visualization sidebar tab.
aim_menu left right_visualization_[tab:visualization]
step 20
button left trigger down
step 2
button left trigger up
step 30
expect menu sidebars
expect representation ballstick
expect layout valid
expect display submitted
expect tracking tracked
expect overlay visible
expect framing valid
snapshot atomistic_ballstick

# Exercise both coarse/atomistic boundaries explicitly. The visualization feed
# starts this run in Ball + Stick, so this first click also covers Ball + Stick -> Full.
aim_menu left right_full_[menu-view-detail-full]
step 20
expect hover right_full_[menu-view-detail-full]
button left trigger down
step 2
button left trigger up
step 45
expect representation full
expect display submitted
expect tracking tracked
snapshot full_from_ballstick

aim_menu left right_ball_&_stick_[menu-view-atomistic-ballstick]
step 20
expect hover right_ball_&_stick_[menu-view-atomistic-ballstick]
button left trigger down
step 2
button left trigger up
step 45
expect representation ballstick
expect display submitted
expect tracking tracked
snapshot ballstick_from_full

aim_menu left right_stick_[menu-view-atomistic-stick]
step 20
expect hover right_stick_[menu-view-atomistic-stick]
button left trigger down
step 2
button left trigger up
step 45
expect representation stick
expect display submitted
expect tracking tracked
snapshot atomistic_stick

aim_menu left right_full_[menu-view-detail-full]
step 20
expect hover right_full_[menu-view-detail-full]
button left trigger down
step 2
button left trigger up
step 45
expect representation full
expect display submitted
expect tracking tracked
snapshot full_from_stick

# Return to the atomistic inspection state and re-check Full -> Ball + Stick.
aim_menu left right_ball_&_stick_[menu-view-atomistic-ballstick]
step 20
expect hover right_ball_&_stick_[menu-view-atomistic-ballstick]
button left trigger down
step 2
button left trigger up
step 45
expect representation ballstick
expect display submitted
expect tracking tracked
snapshot atomistic_ballstick_return
