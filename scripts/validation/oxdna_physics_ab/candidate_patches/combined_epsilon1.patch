+void CUDABaseThermostat::_setup_rigid_flags() {
+    std::vector<int> flags(CONFIG_INFO->N());
+    int n_rigid = 0;
+    for(auto p: CONFIG_INFO->particles()) {
+        flags[p->index] = p->is_rigid_body() ? 1 : 0;
+        n_rigid += flags[p->index];
