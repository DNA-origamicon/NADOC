+        if(!_thermostat_particle_ids) throw oxDNAException("Rigid mask requires stable CUDA particle IDs");
+        CUDA_SAFE_CALL(GpuUtils::LR_cudaMalloc<int>(&_d_rigid_flags, flags.size()*sizeof(int)));
