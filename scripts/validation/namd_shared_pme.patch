+
+// Experimental, opt-in reuse for the two mutually exclusive PME execution paths.
+// ScriptTcl switches CUDASOAintegrate between minimization and dynamics. Only
+// one process, replica, device and grid are allowed here; other modes retain
+// their original ownership. Neither grid contains persistent physical state.
+namespace {
+bool sharedPmeEnabled() {
+#if defined(NAMD_CUDA) && defined(NODEGROUP_FORCE_REGISTER)
+  const char *enabled = std::getenv("NADOC_SHARED_PME");
+  const SimParameters *sp = Node::Object()->simParameters;
+  return enabled && !strcmp(enabled, "1") && sp->CUDASOAintegrateMode &&
+    sp->usePMECUDA && !sp->alchOn && CkNumNodes() == 1 &&
+    CmiNumPartitions() == 1 && deviceCUDA->getNumDevice() == 1 &&
+    !deviceCUDA->isGpuReservedPme() && sp->PMEPencilsX <= 1 &&
+    sp->PMEPencilsY <= 1 && sp->PMEPencilsZ <= 1;
+#else
+  return false;
+#endif
+}
+
+struct SharedPmeStorage {
+  std::mutex mutex;
+  void *buffers[2] = {NULL, NULL};  // real grid, complex grid
+  size_t bytes[2] = {0, 0};
+  int owners[2] = {0, 0};
+  cufftHandle plans[2] = {0, 0};  // forward and reverse retain separate workspaces
+  int planOwners[2] = {0, 0};
+  int dimensions[2][3] = {{0, 0, 0}, {0, 0, 0}};
+};
+SharedPmeStorage sharedPme;
+
+template <typename T>
+void acquirePmeGrid(T **ptr, size_t count, int slot) {
+  if (!sharedPmeEnabled()) {
+    allocate_device<T>(ptr, count);
+    return;
+  }
+  size_t bytes = sizeof(T) * count;
+  if (slot == 0) {
+    // Resident PME pads float ELEMENT counts to textureAlignment.
+    int device;
+    cudaDeviceProp prop;
+    cudaCheck(cudaGetDevice(&device));
+    cudaCheck(cudaGetDeviceProperties(&prop, device));
+    const size_t alignment = sizeof(float) * prop.textureAlignment;
+    bytes = ((bytes + alignment - 1) / alignment) * alignment;
+  }
+  std::lock_guard<std::mutex> guard(sharedPme.mutex);
+  if (sharedPme.owners[slot] == 0) {
+    cudaCheck(cudaMalloc(&sharedPme.buffers[slot], bytes));
+    sharedPme.bytes[slot] = bytes;
+  } else if (sharedPme.bytes[slot] != bytes || sharedPme.owners[slot] >= 2) {
+    NAMD_bug("Shared PME grid dimensions or ownership changed");
+  }
+  ++sharedPme.owners[slot];
+  *ptr = static_cast<T *>(sharedPme.buffers[slot]);
+}
+
+template <typename T>
+void releasePmeGrid(T **ptr) {
+  std::lock_guard<std::mutex> guard(sharedPme.mutex);
+  for (int slot = 0; slot < 2; ++slot) {
+    if (*ptr != NULL && *ptr == sharedPme.buffers[slot]) {
+      if (--sharedPme.owners[slot] == 0) {
+        cudaCheck(cudaFree(sharedPme.buffers[slot]));
+        sharedPme.buffers[slot] = NULL;
+        sharedPme.bytes[slot] = 0;
+      }
+      *ptr = NULL;
+      return;
+    }
+  }
+  deallocate_device<T>(ptr);
+}
+
+void acquirePmePlan(cufftHandle *plan, int z, int y, int x, cufftType type) {
+  if (!sharedPmeEnabled()) {
+    cufftCheck(cufftPlan3d(plan, z, y, x, type));
+    return;
+  }
+  const int slot = type == CUFFT_R2C ? 0 : 1;
+  std::lock_guard<std::mutex> guard(sharedPme.mutex);
+  if (sharedPme.planOwners[slot] == 0) {
+    cufftCheck(cufftPlan3d(&sharedPme.plans[slot], z, y, x, type));
+    sharedPme.dimensions[slot][0] = x;
+    sharedPme.dimensions[slot][1] = y;
+    sharedPme.dimensions[slot][2] = z;
+  } else if (sharedPme.dimensions[slot][0] != x ||
+             sharedPme.dimensions[slot][1] != y ||
+             sharedPme.dimensions[slot][2] != z ||
+             sharedPme.planOwners[slot] >= 2) {
+    NAMD_bug("Shared PME plan dimensions or ownership changed");
+  }
+  ++sharedPme.planOwners[slot];
+  *plan = sharedPme.plans[slot];
+}
+
+void releasePmePlan(cufftHandle plan) {
+  std::lock_guard<std::mutex> guard(sharedPme.mutex);
+  for (int slot = 0; slot < 2; ++slot) {
+    if (sharedPme.planOwners[slot] && sharedPme.plans[slot] == plan) {
+      if (--sharedPme.planOwners[slot] == 0) {
+        cufftCheck(cufftDestroy(plan));
+        sharedPme.plans[slot] = 0;
+      }
+      return;
+    }
+  }
+  cufftCheck(cufftDestroy(plan));
+}
