diff --git a/oxDNA/CMakeLists.txt b/oxDNA/CMakeLists.txt
index 4aaa753..b9444fd 100644
--- a/oxDNA/CMakeLists.txt
+++ b/oxDNA/CMakeLists.txt
@@ -87,16 +87,16 @@ IF(CUDA)
 	INCLUDE_DIRECTORIES(${CUDA_INSTALL_PREFIX}/include/)
 	LINK_DIRECTORIES(${CUDA_INSTALL_PREFIX}/lib)
 	
-	INCLUDE(select_compute_arch.cmake)
-	
-	IF(CUDA_COMMON_ARCH)
-		CUDA_SELECT_NVCC_ARCH_FLAGS(ARCH_FLAGS Common)
-	ELSE(CUDA_COMMON_ARCH)
-		CUDA_SELECT_NVCC_ARCH_FLAGS(ARCH_FLAGS Auto)
-	ENDIF(CUDA_COMMON_ARCH)
-	
-	MESSAGE(STATUS "Generating code for the following CUDA architectures: ${ARCH_FLAGS_readable}")
-	LIST(APPEND CUDA_NVCC_FLAGS ${ARCH_FLAGS})
+	# CUDA13/CCCL compat: shadow patched CUB header (qualified data()/size()) before system include
+	LIST(APPEND CUDA_NVCC_FLAGS "-I${CMAKE_CURRENT_SOURCE_DIR}/cuda_compat")
+	# CUDA13: emit gencode as SEPARATE list tokens so the separable-compilation device-link
+	# step accepts them (CUDA_SELECT_NVCC_ARCH_FLAGS joins them into one string that nvcc -dlink
+	# rejects as "Unknown option '-gencode arch=...'"). Override the arch with -DOXDNA_CUDA_ARCH=NN.
+	IF(NOT OXDNA_CUDA_ARCH)
+		SET(OXDNA_CUDA_ARCH "75")
+	ENDIF()
+	MESSAGE(STATUS "Generating code for CUDA architecture sm_${OXDNA_CUDA_ARCH}")
+	LIST(APPEND CUDA_NVCC_FLAGS "-gencode" "arch=compute_${OXDNA_CUDA_ARCH},code=sm_${OXDNA_CUDA_ARCH}")
 	MESSAGE(STATUS "${CUDA_NVCC_FLAGS}")
    
 	IF(G)
diff --git a/oxDNA/src/CMakeLists.txt b/oxDNA/src/CMakeLists.txt
