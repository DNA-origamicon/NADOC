--- a/oxDNA/src/CMakeLists.txt
+++ b/oxDNA/src/CMakeLists.txt
@@ -245,6 +245,9 @@ IF(CUDA)
 		Utilities/Timings.cpp
 	)
 	
+	# CUDA13: cross-TU __global__ kernel launches (CUDA_sort.cu kernels called from backends)
+	# need relocatable device code + a device link step.
+	SET(CUDA_SEPARABLE_COMPILATION ON)
 	CUDA_ADD_EXECUTABLE(${exe_name} ${oxDNA_SOURCES} ${oxDNA_CUDASOURCES})
 	CUDA_ADD_EXECUTABLE(DNAnalysis ${DNAnalysis_SOURCES} Utilities/Timings.cpp)
 ELSE()
