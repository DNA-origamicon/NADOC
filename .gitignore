# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Node
node_modules/
frontend/dist/
package-lock.json

# Playwright generated output
frontend/playwright-report/
frontend/test-results/
test-results/
# Shared-renderer diagnostic screenshots — regenerated on every diag run.
frontend/e2e/screenshots/shared_renderer_diag/
# E2E bench screenshots — scratch output; the .json bench results stay tracked.
frontend/e2e/bench_results/*.png

# NAMD binary (download separately from UIUC)
NAMD_*/

# ── GROMACS simulation outputs ────────────────────────────────────────────────
# Trajectories and large binary outputs (not version-controlled)
*.xtc
*.trr
*.edr
*.tpr
*.cpt
*.gro
*.npz

# GROMACS scratch / auto-generated files
mdout.mdp
ions.mdp
ions.tpr
step*.pdb
\#*\#
.\#*

# Force field directories (installed system-wide, not project code)
*.ff/

# Run logs (stdout from bash run scripts — large, not useful in git)
run.log

# GROMACS per-phase logs (large, regenerable by re-running)
em.log
nvt.log
npt.log
prod.log

# Intermediate adapted PDB passed to pdb2gmx (input_nadoc.pdb is the canonical input)
input.pdb

# ── NAMD simulation outputs ──────────────────────────────────────────────────
# Trajectories and binary restart files (large, regenerable, not version-controlled)
*.dcd
*.dcd.BAK
*.restart.coor
*.restart.coor.old
*.restart.vel
*.restart.vel.old
*.restart.xsc.old
*.coor.BAK
*.vel.BAK
# NAMD per-run output directories (binary data)
experiments/*/results/*/output/
experiments/*/results/namd_run/
# Solvated run directories (large PSF/PDB/ITP outputs, never in git)
experiments/*/results/solvated/

# Additional NAMD/mrDNA generated files
*.coor
*.vel
*.xsc
*.xst
*.BAK
*.extrabonds
*.bd
*.particles.txt

# Local experiment result trees and benchmark scratch.
# Keep experiment docs/scripts trackable; keep generated run packages local.
experiments/exp23_periodic_cell_benchmark/results/hyp_runs/
experiments/exp23_periodic_cell_benchmark/results/*_run/
experiments/exp23_periodic_cell_benchmark/results/single_helix_*/
experiments/exp25_full_origami_relaxation/results/runs/
experiments/exp26_hardware_benchmark/bench_output/
experiments/exp26_hardware_benchmark/bench_output
experiments/exp26_hardware_benchmark/_tmp.conf
experiments/exp26_hardware_benchmark/run_log.txt
experiments/exp27_mrdna_namd_precondition/results/
experiments/exp28_hierarchical_tube_cg/results/

# Generated experiment caches and bulky derived potentials
experiments/**/__pycache__/
experiments/**/mrdna/potentials/
experiments/**/performance_benchmarks/
experiments/**/bench_output/
experiments/**/run_logs/

# ── Bulk simulation run directories ──────────────────────────────────────────
bp_health_runs/
gromacs_run/
runs/
workspace/

# ── Literature and large binary assets ───────────────────────────────────────
Literature/
*.zip
*.tar.gz
*.tgz

# ── Claude Code config ───────────────────────────────────────────────────────
# `.claude/*` (not `.claude/`) so the negations below can re-include children:
# git cannot re-include a file whose parent DIRECTORY is excluded.
# Shared across both computers: the path-scoped rules + the session skills + on-demand runbooks.
# Machine-local: settings.local.json (permission allowlist), worktrees/.
.claude/*
!.claude/rules/
!.claude/skills/
!.claude/runbooks/

# ── SSH keys (should never be committed) ─────────────────────────────────────
sshIDKEY
sshIDKEY.pub
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ── Misc logs ────────────────────────────────────────────────────────────────
monitor_v2.log

# ── Large MD experiment reference structures (regenerable; never pushed) ─────
# Relaxed all-atom reference designs/coords are tens of MB each; keep local.
# Scoped to experiment result dirs so Examples/*.nadoc stays tracked.
experiments/*/results/*.nadoc
experiments/*/results/*.pdb
experiments/*/results/*.dcd
experiments/*/results/*.psf

# ── exp31+ skip-twist / autorefine / MD-validation run packages ──────────────
# The per-experiment `ws/` (and `ws_<variant>/`) working dirs hold generated
# oxDNA/NAMD job trees — multi-GB trajectory.dat sets, never pushed.  Matches the
# "track experiment docs/scripts, keep generated run packages local" convention
# above; extends it to exp31–exp35+ which the older exp-specific rules didn't cover.
experiments/**/ws/
experiments/**/ws_*/
# Per-run driver / watchdog / monitor process logs at each experiment root
# (result logs live under results/ and stay tracked).
experiments/*/*.log
# Aggregated per-sweep result dumps (multi-MB, regenerable from run.py + ws/).
experiments/*/results/results.json
# exp36 relax-cutoff frame banks + any large tab-separated frame dumps (multi-MB,
# regenerable by replaying the run; keep the bank_parser/cutoff_replay scripts).
experiments/**/bank/
experiments/**/bank_*/
experiments/**/*.tsv
# Other multi-hundred-KB per-run result JSON blobs (regenerable).
experiments/*/results/longrun_result.json

# ── Scratch fixture design (regenerable headlessly) ──────────────────────────
# 3x6x200_test.nadoc is the MD-display-toggle E2E fixture; NOT a curated Example.
# Rebuild with:  uv run python -m scripts.build_3x6x200_test
/3x6x200_test.nadoc

# ── Editor / tool local state (machine-specific, not user content) ───────────
.codex
.coverage
.vscode/
# `just test`/`test-all` record the SHA of the last FULL-suite pass here so
# `just test-smart` can scope against it. Per-machine baseline; never synced.
.nadoc-test-watermark

# scripts/test_guard.sh exclusive-run lock (mkdir dir holding pid+label). Machine-local.
.nadoc-test.lock/

# Test-dedicated session window (scripts/test_session.sh) — the TTY-only unlock for the
# slow suites. Machine-local and short-lived; never synced.
.nadoc-test-session

# Heavy test groups a fast-only session deferred (owed until the next test-dedicated
# session), and the per-test duration report feeding the slow-test triage subagent.
.nadoc-slow-pending
.nadoc-slow-candidates.json

# LAMMPS default runtime log (dropped in cwd on a run)
log.lammps
